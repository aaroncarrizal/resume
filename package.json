{
  "private": true,
  "workspaces": [
    "core",
    "adapters/*",
    "scripts"
  ],
  "scripts": {
    "optimize": "tsx --env-file=.env scripts/optimize.ts",
    "pdf": "tsx scripts/pdf.ts",
    "pdf:base": "tsx scripts/pdf.ts --base",
    "dev": "npm run dev -w @resume/react-renderer",
    "dev:base": "npm run dev:base -w @resume/react-renderer",
    "start": "npm run optimize && npm run pdf",
    "start:base": "npm run pdf:base"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
